+
+/// A [`TypeFolder`] that rewrites `&mut old_inner` → `&mut new_inner` in a type tree.
+///
+/// Used by [`PlacesTree::replace_mut_ref`] to propagate post-call refinement types
+/// into struct Downcast fields after an `&strg T` call via a `&mut T` reborrow.
+struct MutRefUpdater<'a> {
+    old_inner: &'a Ty,
+    new_inner: &'a Ty,
+}
+
+impl TypeFolder for MutRefUpdater<'_> {
+    fn fold_bty(&mut self, bty: &BaseTy) -> BaseTy {
+        if let BaseTy::Ref(re, inner, Mutability::Mut) = bty
+            && inner == self.old_inner
+        {
+            return BaseTy::Ref(*re, self.new_inner.clone(), Mutability::Mut);
+        }
+        bty.super_fold_with(self)
+    }
+}
