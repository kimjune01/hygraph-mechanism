+/// Returns `true` when the `fold_local_ptrs` subtyping check should be replaced
+/// by [`PlacesTree::replace_mut_ref`] instead.
+///
+/// This fires when `bound` is an indexed ADT type and `ty`'s index contains a Lambda
+/// (`ExprKind::Abs`). That pattern arises when a `&strg T` call (via a `&mut T`
+/// reborrow) changed a function-sort field such as `hdl get: int -> bool`. In that
+/// case `subtyping(ty, bound)` would call `idxs_eq` which generates an unprovable
+/// lambda-equality constraint (e.g. `∀v. (v==0||f(v)) == f(v)`) for opaque abstract
+/// refinements.  The subsequent struct fold (`check_constructor`) verifies the ADT's
+/// actual invariants; the equality check here is both redundant and overly strict.
+///
+/// For all other cases (primitive indexed types, constrained existentials, ADT types
+/// whose post index contains no Lambda) the original `subtyping` check is kept.
+fn fold_local_ptr_needs_replace(bound: &Ty, ty: &Ty) -> bool {
+    struct ContainsAbs;
+    impl TypeVisitor for ContainsAbs {
+        type BreakTy = ();
+        fn visit_expr(&mut self, e: &Expr) -> ControlFlow<()> {
+            if matches!(e.kind(), ExprKind::Abs(_)) {
+                ControlFlow::Break(())
+            } else {
+                e.super_visit_with(self)
+            }
+        }
+    }
+    match (ty.kind(), bound.kind()) {
+        (TyKind::Indexed(BaseTy::Adt(..), ty_idx), TyKind::Indexed(BaseTy::Adt(..), _)) => {
+            ty_idx.visit_with(&mut ContainsAbs).is_break()
+        }
+        _ => false,
+    }
+}
