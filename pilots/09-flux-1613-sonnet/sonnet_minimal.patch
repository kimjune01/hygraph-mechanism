+    /// Returns `true` if this sort or any field sort (transitively) is a function sort.
+    /// Used to detect composite sorts containing abstract refinements of function type,
+    /// e.g. `refined_by(len: int, hdl get: int -> bool)`.
+    pub fn has_func_sort(&self) -> bool {
+        let mut found = false;
+        self.walk(|sort, _| {
+            if matches!(sort, Sort::Func(_)) {
+                found = true;
+            }
+        });
+        found
+    }
