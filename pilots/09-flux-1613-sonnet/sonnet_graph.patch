+    /// Walk every `Downcast` binding in the tree and replace `&mut <target>` (found at any depth
+    /// inside that binding) with `&mut <replacement>`.  Returns `true` if at least one replacement
+    /// was made.
+    ///
+    /// The search is intentionally restricted to **`Downcast` bindings** (i.e. unfolded struct
+    /// fields).  For those, the subsequent struct `fold` will re-check the struct invariant using
+    /// the updated field type, so no extra subtyping constraint is needed here.  For direct `&mut T`
+    /// bindings (function parameters, temporaries) the original `T_new <: T_old` subtyping check
+    /// is the only guard, so we must *not* skip it.
+    ///
+    /// This is used by [`TypeEnv::fold_local_ptrs`] to write the updated type of a local pointer
+    /// created by `unfold_local_ptrs` back into the parent struct field that originally supplied
+    /// the `&mut` reference, thereby propagating the mutation effect to the struct without
+    /// generating an unprovable equality constraint on abstract function components.
+    pub(crate) fn replace_mut_ref(&mut self, target: &Ty, replacement: &Ty) -> bool {
+        let mut replacer = MutRefReplacer { target, replacement, replaced: false };
+        for (_, binding) in self.map.iter_mut() {
+            if matches!(binding.ty.kind(), TyKind::Downcast(..)) {
+                binding.ty = binding.ty.fold_with(&mut replacer);
+            }
+        }
+        replacer.replaced
+    }
