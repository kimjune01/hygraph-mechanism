+/// A [`TypeFolder`] that replaces every occurrence of `&mut <target>` with `&mut <replacement>`
+/// at any depth in a type.  Used by [`PlacesTree::replace_mut_ref`].
+struct MutRefReplacer<'a> {
+    target: &'a Ty,
+    replacement: &'a Ty,
+    replaced: bool,
+}
+
+impl TypeFolder for MutRefReplacer<'_> {
+    fn fold_ty(&mut self, ty: &Ty) -> Ty {
+        if let TyKind::Indexed(BaseTy::Ref(re, inner, Mutability::Mut), _) = ty.kind() {
+            if inner == self.target {
+                self.replaced = true;
+                return Ty::mk_ref(*re, self.replacement.clone(), Mutability::Mut);
+            }
+        }
+        ty.super_fold_with(self)
+    }
+}
