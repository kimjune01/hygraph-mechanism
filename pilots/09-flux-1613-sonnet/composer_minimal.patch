+fn idx_for_fold(adt: &AdtDef, ty_: &Ty, fields: &[Ty], infcx: &mut InferCtxt) -> Vec<Expr> {
+    if let TyKind::Indexed(_, idx) = ty_.kind() {
+        let sort_def = adt.sort_def();
+        return sort_def
+            .struct_variant()
+            .projections(sort_def.did())
+            .map(|proj| idx.proj_and_reduce(proj))
+            .collect();
+    }
+    idx_from_fields(adt, fields, infcx)
+}
+
+/// Reconstruct the index of a struct from its (folded) field types. This is the inverse of
+/// [`downcast_struct`]: when folding, we need the index to substitute for the bound refinement
+/// parameters in the variant signature instead of generating fresh inference variables.
+fn idx_from_fields(adt: &AdtDef, fields: &[Ty], infcx: &mut InferCtxt) -> Vec<Expr> {
+    let sort_def = adt.sort_def();
+    let n = sort_def.struct_variant().fields();
+    debug_assert_eq!(fields.len(), n);
+    (0..n)
+        .map(|i| idx_expr_from_field_ty(&infcx.unpack(&fields[i])))
+        .collect()
+}
+
+fn idx_expr_from_field_ty(field_ty: &Ty) -> Expr {
+    match field_ty.kind() {
+        TyKind::Indexed(bty, idx) => match bty {
+            BaseTy::Ref(_, inner, _) => {
+                if let TyKind::Indexed(_, inner_idx) = inner.kind() {
+                    inner_idx.clone()
+                } else {
+                    idx.clone()
+                }
+            }
+            _ => idx.clone(),
+        },
+        _ => tracked_span_bug!("expected indexed field type, got `{field_ty:?}`"),
+    }
+}
