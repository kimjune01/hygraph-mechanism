+/// Whether to skip the `T1 <: T2` check when folding a local pointer. Subtyping between indexed
+/// types with abstract (function-valued) refinements can add constraints that break later folds
+/// on enclosing structs with composite indices; the callee's `ensures` already certifies the update.
+fn skip_fold_local_subtyping(bound: &Ty, new_inner: &Ty) -> bool {
+    fn has_func_refinement(ty: &Ty) -> bool {
+        if let TyKind::Indexed(BaseTy::Adt(adt, _), _) = ty.kind() {
+            return adt
+                .sort_def()
+                .struct_variant()
+                .field_sorts_instantiate_identity()
+                .iter()
+                .any(|sort| matches!(sort, Sort::Func(_)));
+        }
+        false
+    }
+    has_func_refinement(bound) || has_func_refinement(new_inner)
+}
