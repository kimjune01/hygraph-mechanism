+    /// When a callee `ensures` updates a location introduced by [`unfold_local_ptr`], the
+    /// stored `LocalPtr` bound (the inner type of the original `&mut`) is stale. Refresh it
+    /// by taking non-function index components from the original bound and function components
+    /// from the post-call type so [`TypeEnv::fold_local_ptrs`] can still check invariants.
+    pub(crate) fn update_local_ptr_bound(&mut self, loc: &Loc, ty: &Ty) {
+        if let Some(binding) = self.map.get_mut(loc)
+            && let LocKind::LocalPtr(bound) = &binding.kind
+        {
+            let merged = merge_local_ptr_bound(bound, ty);
+            binding.kind = LocKind::LocalPtr(merged);
+        }
+    }
