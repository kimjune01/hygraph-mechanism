+fn merge_local_ptr_bound(bound: &Ty, ty: &Ty) -> Ty {
+    let TyKind::Indexed(bty_b, idx_b) = bound.kind() else {
+        return ty.clone();
+    };
+    let TyKind::Indexed(bty_t, idx_t) = ty.kind() else {
+        return bound.clone();
+    };
+    if bty_b != bty_t {
+        return ty.clone();
+    }
+    let BaseTy::Adt(adt, _) = bty_b else {
+        return ty.clone();
+    };
+    let sort_def = adt.sort_def();
+    let field_sorts = sort_def.struct_variant().field_sorts_instantiate_identity();
+    let did = adt.did();
+    let projs: Vec<_> = sort_def.struct_variant().projections(did).collect();
+    let merged_flds = field_sorts
+        .iter()
+        .enumerate()
+        .map(|(i, sort)| {
+            let b = idx_b.proj_and_reduce(projs[i]);
+            let t = idx_t.proj_and_reduce(projs[i]);
+            if matches!(sort, Sort::Func(_)) { t } else { b }
+        })
+        .collect_vec();
+    Ty::indexed(bty_b.clone(), Expr::ctor_struct(did, merged_flds.into()))
+}
