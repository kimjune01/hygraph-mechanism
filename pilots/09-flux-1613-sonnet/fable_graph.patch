+/// Count the number of pointers to `loc` in the environment.
+fn count_ptr_refs(bindings: &PlacesTree, loc: &Loc) -> usize {
+    struct Counter<'a>(&'a Loc, usize);
+
+    impl TypeVisitor for Counter<'_> {
+        fn visit_ty(&mut self, ty: &Ty) -> ControlFlow<Self::BreakTy> {
+            if let TyKind::Ptr(_, path) = ty.kind()
+                && path.loc == *self.0
+            {
+                self.1 += 1;
+            }
+            ty.super_visit_with(self)
+        }
+    }
+
+    let mut counter = Counter(loc, 0);
+    for (_, binding) in bindings.iter() {
+        let _ = binding.ty.visit_with(&mut counter);
+    }
+    counter.1
 }
 
