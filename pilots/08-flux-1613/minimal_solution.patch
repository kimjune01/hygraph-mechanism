+fn needs_tracked_reborrow(ty: &Ty) -> bool {
+    if let TyKind::Indexed(BaseTy::Adt(adt, args), _) = ty.kind()
+        && let Some(variant) = adt.sort_def().opt_struct_variant()
+    {
+        let sort_args = adt
+            .sort_def()
+            .filter_generic_args(args)
+            .map(|arg| arg.expect_base().sort())
