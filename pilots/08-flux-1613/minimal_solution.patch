diff --git a/tests/tests/neg/surface/composite_sort_setter.rs b/tests/tests/neg/surface/composite_sort_setter.rs
new file mode 100644
index 0000000000..4e1b5ca5a0
--- /dev/null
+++ b/tests/tests/neg/surface/composite_sort_setter.rs
@@ -0,0 +1,22 @@
+#[flux::opaque]
+#[flux::refined_by(len: int, hdl get: int -> bool)]
+struct Slot([bool]);
+
+impl Slot {
+    #[flux::trusted]
+    #[flux::sig(fn(self: &strg Slot[@n, @f]) ensures self: Slot[0, f])]
+    fn clear_len(&mut self) {}
+}
+
+#[flux::refined_by(slot: Slot)]
+struct Container<'a> {
+    #[flux::field({&mut Slot[slot] | slot.len > 0})]
+    slot: &'a mut Slot,
+}
+
+impl<'a> Container<'a> {
+    #[flux::sig(fn(self: &strg Container[@s]) ensures self: Container)]
+    fn update(&mut self) {
+        self.slot.clear_len();
+    } //~ ERROR type invariant may not hold
+}
diff --git a/tests/tests/pos/surface/composite_sort_setter.rs b/tests/tests/pos/surface/composite_sort_setter.rs
new file mode 100644
index 0000000000..96a42fdf32
--- /dev/null
+++ b/tests/tests/pos/surface/composite_sort_setter.rs
@@ -0,0 +1,27 @@
+#[flux::opaque]
+#[flux::refined_by(len: int, hdl get: int -> bool)]
+struct Slot([bool]);
+
+impl Slot {
+    #[flux::trusted]
+    #[flux::sig(
+        fn(self: &strg Slot[@n, @f], i: usize{i < n})
+        ensures self: Slot[n, |j| j == i || f(j)]
+    )]
+    fn set(&mut self, i: usize) {
+        self.0[i] = true;
+    }
+}
+
+#[flux::refined_by(slot: Slot)]
+struct Container<'a> {
+    #[flux::field({&mut Slot[slot] | slot.len > 0})]
+    slot: &'a mut Slot,
+}
+
+impl<'a> Container<'a> {
+    #[flux::sig(fn(self: &strg Container[@s]) ensures self: Container)]
+    fn update(&mut self) {
+        self.slot.set(0);
+    }
+}
