+fn place_prefix_before_deref(place: &Place) -> Option<Place> {
+    if matches!(place.projection.last(), Some(PlaceElem::Deref)) {
+        let mut place = place.clone();
+        place.projection.pop();
+        Some(place)
+    } else {
+        None
+    }
+}
