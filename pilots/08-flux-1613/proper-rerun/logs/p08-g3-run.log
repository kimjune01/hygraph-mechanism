    }
}

impl LookupKey for Path {
    fn loc(&self) -> Loc {
        self.loc
    }

    fn proj(&self) -> impl DoubleEndedIterator<Item = PlaceElem> {
        self.projection().iter().map(|f| PlaceElem::Field(*f))
    }
}

