+func acceptsJSON(r *http.Request) bool {
+	for _, header := range r.Header.Values("Accept") {
+		for _, accept := range strings.Split(header, ",") {
+			mediaType := strings.ToLower(strings.TrimSpace(strings.SplitN(accept, ";", 2)[0]))
+			if mediaType == "application/json" {
+				return true
+			}
+		}
+	}
+
+	return false
+}
+
+func addVaryAccept(h http.Header) {
+	for _, vary := range h.Values("Vary") {
+		for _, value := range strings.Split(vary, ",") {
+			if strings.EqualFold(strings.TrimSpace(value), "Accept") {
+				return
+			}
+		}
+	}
+	h.Add("Vary", "Accept")
+}
+
+func redirectURL(r *http.Request, redirectHost string) string {
+	u := r.URL
+	// Never set by the Go HTTP library.
+	u.Scheme = "https"
+	u.Host = redirectHost
+	return u.String()
+}
+
+func writeJSONRedirect(w http.ResponseWriter, r *http.Request, location string) {
+	body := []byte("{}")
+	defaultResponseHeaders(w.Header(), r, "application/json")
+	w.Header().Set("Location", location)
+	w.Header().Set("Content-Length", strconv.Itoa(len(body)))
+	w.WriteHeader(http.StatusMovedPermanently)
+	if r.Method != http.MethodHead {
+		w.Write(body)
+	}
+}
