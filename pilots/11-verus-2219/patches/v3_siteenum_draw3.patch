     VERUS_ERASURE_CTXT.read().unwrap().clone()
 }
 
+pub(crate) fn is_erased_ghost_value_fn_def_id(def_id: DefId) -> bool {
+    matches!(
+        get_verus_erasure_ctxt_option(),
+        Some(erasure_ctxt) if erasure_ctxt.erased_ghost_value_fn_def_id == def_id
+    )
+}
