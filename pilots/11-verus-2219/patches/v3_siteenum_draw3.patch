+fn is_verus_erased_ghost_value_call<'tcx>(func: &Operand<'tcx>) -> bool {
+    let Operand::Constant(func) = func else {
+        return false;
+    };
+    let ty::FnDef(def_id, _) = func.const_.ty().kind() else {
+        return false;
+    };
+    crate::verus::is_erased_ghost_value_fn_def_id(*def_id)
+}
