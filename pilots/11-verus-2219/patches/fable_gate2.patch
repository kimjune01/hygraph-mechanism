+/// Is the given THIR node's value produced by erasure, looking through scopes, blocks,
+/// and value-preserving wrappers? Used for `!`-typed (more generally, uninhabited-typed)
+/// expressions: a ghost value of an uninhabited type does exist in ghost code, so it must
+/// not be treated as diverging. Conservative: returns false for anything else (e.g. reads
+/// of kept vars of type `!`), which keeps standard rustc reachability semantics there.
+pub(crate) fn is_erased_value_deep<'tcx>(
+    cx: &ThirBuildCx<'tcx>,
+    erasure_ctxt: &VerusErasureCtxt,
+    expr_id: ExprId,
+) -> bool {
+    let kind = &cx.thir.exprs[expr_id].kind;
+    if is_erased(cx, erasure_ctxt, kind) {
+        return true;
+    }
+    match kind {
+        ExprKind::Scope { value, .. } => is_erased_value_deep(cx, erasure_ctxt, *value),
+        ExprKind::Use { source }
+        | ExprKind::NeverToAny { source }
+        | ExprKind::ValueTypeAscription { source, .. } => {
+            is_erased_value_deep(cx, erasure_ctxt, *source)
+        }
+        ExprKind::Block { block } => match cx.thir.blocks[*block].expr {
+            Some(e) => is_erased_value_deep(cx, erasure_ctxt, e),
+            None => false,
+        },
+        _ => false,
+    }
+}
