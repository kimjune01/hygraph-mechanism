+/// If this is a Verus-erased ghost value of type `!`, return the tuple argument
+/// that carries the subexpressions kept for Rust's checks.
+pub(crate) fn erased_ghost_value_tuple_arg_for_never<'tcx>(
+    thir: &thir::Thir<'tcx>,
+    expr_id: ExprId,
+) -> Option<ExprId> {
+    let erasure_ctxt = get_verus_erasure_ctxt_option()?;
+    let expr = &thir.exprs[expr_id];
+    match &expr.kind {
+        ExprKind::Call { fun, args, .. } if expr.ty.is_never() => {
+            match thir.exprs[*fun].ty.kind() {
+                TyKind::FnDef(fn_def_id, _)
+                    if *fn_def_id == erasure_ctxt.erased_ghost_value_fn_def_id =>
+                {
+                    Some(args[0])
+                }
+                _ => None,
+            }
+        }
+        ExprKind::Scope { value, .. } => erased_ghost_value_tuple_arg_for_never(thir, *value),
+        _ => None,
+    }
+}
