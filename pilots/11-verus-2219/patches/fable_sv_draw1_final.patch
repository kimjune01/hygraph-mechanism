+/// Determine whether the given HIR expression (which has type `!` or some other
+/// uninhabited type) produces a *ghost* value, i.e., a value that exists only for
+/// verification purposes. Ghost values never cause divergence at runtime (the code
+/// is erased at runtime, and ghost code is total), and Verus's verification semantics
+/// treats all types as inhabited in ghost code. Therefore, when this returns true,
+/// the MIR builder must NOT treat the code following this expression as unreachable;
+/// otherwise borrow-checking of tracked resources would be silently skipped on paths
+/// the verifier considers reachable. (See https://github.com/verus-lang/verus/issues/2219)
+///
+/// This returns true only when we can positively identify the value as ghost:
+///  - erased nodes (which become `erased_ghost_value` calls)
+///  - calls whose callee is a spec/proof function or ghost operator
+///  - proof-mode (e.g. `tracked`) variable uses, and projections (fields, derefs,
+///    indexing) based on such values
+///  - blocks/ifs/matches where some resulting branch produces such a value
+///    (if *any* branch produces a ghost value non-divergently, the join point is
+///    reachable in the verification semantics)
+/// For anything else (in particular, all exec code) we return false, preserving
+/// rustc's usual treatment of diverging expressions.
+pub(crate) fn hir_never_value_is_ghost<'tcx>(
+    erasure_ctxt: &VerusErasureCtxt,
+    expr: &'tcx hir::Expr<'tcx>,
+) -> bool {
+    if erasure_ctxt.adjusted_node_erasure.contains(&expr.hir_id) {
+        // Erased entirely (including adjustments): becomes erased_ghost_value
+        return true;
+    }
+    match &expr.kind {
+        hir::ExprKind::Call(..) | hir::ExprKind::MethodCall(..) => {
+            // Erased calls become erased_ghost_value; kept ghost calls are total
+            erasure_ctxt.non_diverging_hir_ids.contains(&expr.hir_id)
+                || matches!(
+                    erasure_ctxt.calls.get(&expr.hir_id),
+                    Some(CallErasure::EraseTree(_) | CallErasure::Call(NodeErase::Erase))
+                )
+        }
+        hir::ExprKind::Path(..) => {
+            // Proof-mode var use, or an erased (spec-mode) var use
+            erasure_ctxt.non_diverging_hir_ids.contains(&expr.hir_id)
+                || matches!(
+                    erasure_ctxt.vars.get(&expr.hir_id),
+                    Some(VarErasure::Erase | VarErasure::Shadow)
+                )
+        }
+        hir::ExprKind::Field(base, _) => hir_never_value_is_ghost(erasure_ctxt, base),
+        hir::ExprKind::Index(base, _, _) => hir_never_value_is_ghost(erasure_ctxt, base),
+        hir::ExprKind::Unary(hir::UnOp::Deref, base) => {
+            hir_never_value_is_ghost(erasure_ctxt, base)
+        }
+        hir::ExprKind::Block(block, _) => match block.expr {
+            Some(tail) => hir_never_value_is_ghost(erasure_ctxt, tail),
+            None => false,
+        },
+        hir::ExprKind::DropTemps(inner) => hir_never_value_is_ghost(erasure_ctxt, inner),
+        hir::ExprKind::If(_cond, then_expr, else_expr) => {
+            hir_never_value_is_ghost(erasure_ctxt, then_expr)
+                || else_expr.map(|e| hir_never_value_is_ghost(erasure_ctxt, e)).unwrap_or(false)
+        }
+        hir::ExprKind::Match(_discr, arms, _) => {
+            arms.iter().any(|arm| hir_never_value_is_ghost(erasure_ctxt, arm.body))
+        }
+        _ => false,
+    }
+}
