+/// Does this call site call a *ghost* (spec/proof) function or ghost operator?
+/// Such calls can never diverge at runtime: ghost code is erased at runtime, and
+/// ghost (spec/proof) code is total. Furthermore, Verus's verification semantics
+/// treats all types as inhabited in ghost code, so even a ghost call that returns
+/// an uninhabited type (e.g. `!`) must be treated as returning normally for the
+/// purposes of lifetime/borrow checking; otherwise the code after the call would be
+/// considered unreachable and its borrow-checking would be silently skipped, even
+/// though the verifier considers that code reachable.
+/// (See https://github.com/verus-lang/verus/issues/2219)
+///
+/// Exec calls (which really exist at runtime and may genuinely diverge) return false,
+/// preserving rustc's usual treatment of calls with uninhabited return types.
+fn resolved_call_never_diverges(
+    functions: &HashMap<Fun, Function>,
+    resolved_call: &ResolvedCall,
+    ctor_mode: Option<Mode>,
+) -> bool {
+    match resolved_call {
+        ResolvedCall::SpecPure | ResolvedCall::SpecAllowProofArgs => true,
+        ResolvedCall::Call(ufun, rfun, in_ghost) => {
+            let Some(f) = functions.get(ufun).or_else(|| functions.get(rfun)) else {
+                return false;
+            };
+            // in_ghost && exec-mode means autospec (exec call used in ghost code,
+            // replaced by its spec counterpart), which is also erased/ghost.
+            *in_ghost || f.x.mode != Mode::Exec
+        }
+        ResolvedCall::Ctor(..) | ResolvedCall::BracesCtor(..) => {
+            // Constructors never diverge regardless of mode, but we only need to
+            // mark ghost ones; exec constructors of uninhabited types can only be
+            // applied to already-diverged values, so rustc's behavior is fine there.
+            matches!(ctor_mode, Some(Mode::Spec | Mode::Proof))
+        }
+        ResolvedCall::NonStaticExec => false,
+        ResolvedCall::NonStaticProof(..) => true,
+        ResolvedCall::CompilableOperator(co) => match co {
+            // Ghost wrappers/operators: erased at runtime, cannot diverge.
+            CompilableOperator::GhostExec
+            | CompilableOperator::TrackedNew
+            | CompilableOperator::TrackedExec
+            | CompilableOperator::TrackedExecBorrow
+            | CompilableOperator::TrackedGet
+            | CompilableOperator::TrackedBorrow
+            | CompilableOperator::TrackedBorrowMut
+            | CompilableOperator::GhostBorrowMut
+            | CompilableOperator::UseTypeInvariant
+            | CompilableOperator::ClosureToFnProof(_)
+            | CompilableOperator::Implies
+            | CompilableOperator::IntIntrinsic => true,
+            // Real exec calls at runtime.
+            CompilableOperator::RcNew
+            | CompilableOperator::ArcNew
+            | CompilableOperator::BoxNew
+            | CompilableOperator::SmartPtrClone { .. } => false,
+        },
+        ResolvedCall::MiscEraseAbsolutely => true,
+        ResolvedCall::InferSpecForLoopIter(_) => true,
+    }
+}
