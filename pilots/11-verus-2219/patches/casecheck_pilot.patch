+    ) -> BasicBlock {
+        let expr = &self.thir[expr_id];
+        let source_info = self.source_info(expr.span);
+        if let ExprKind::Scope { region_scope, lint_level, value } = expr.kind {
+            return self.in_scope((region_scope, source_info), lint_level, |this| {
