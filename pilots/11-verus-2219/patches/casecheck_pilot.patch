+                unreachable!();
+            };
+            let args = args.clone();
+            return self.eval_verus_erased_ghost_value_args(block, temp_lifetime, &args);
+        }
+
+        unpack!(block = self.as_temp(block, temp_lifetime, expr_id, Mutability::Mut));
+        block
