+pub(crate) fn typ_is_rust_uninhabited(
+    typ: &Typ,
+    datatypes: &HashMap<Path, Datatype>,
+) -> bool {
+    fn typ_is_uninhabited(typ: &Typ, datatypes: &HashMap<Path, Datatype>, seen: &mut HashSet<Dt>) -> bool {
+        match &**typ {
+            TypX::Decorate(TypDecoration::Never, _, _) => true,
+            TypX::Decorate(_, _, typ) => typ_is_uninhabited(typ, datatypes, seen),
+            TypX::Datatype(Dt::Tuple(_), typs, _) => {
+                typs.iter().any(|typ| typ_is_uninhabited(typ, datatypes, seen))
+            }
+            TypX::Datatype(dt, typs, _) => {
+                if !seen.insert(dt.clone()) {
+                    return false;
+                }
+                let res = match dt {
+                    Dt::Path(path) => {
+                        let Some(datatype) = datatypes.get(path) else {
+                            seen.remove(dt);
+                            return false;
+                        };
+                        path.segments.iter().any(|s| s.ends_with("Infallible"))
+                            || datatype.x.variants.len() == 0
+                            || datatype.x.variants.iter().all(|variant| {
+                                variant.fields.iter().any(|field| {
+                                    let typ = subst_typ_for_datatype(
+                                        &datatype.x.typ_params,
+                                        typs,
+                                        &field.a.0,
+                                    );
+                                    typ_is_uninhabited(&typ, datatypes, seen)
+                                })
+                            })
+                    }
+                    Dt::Tuple(_) => unreachable!(),
+                };
+                seen.remove(dt);
+                res
+            }
+            _ => false,
+        }
+    }
+
+    typ_is_uninhabited(typ, datatypes, &mut HashSet::new())
+}
+
+fn expr_contains_uninhabited_typ(expr: &Expr, datatypes: &HashMap<Path, Datatype>) -> bool {
+    let mut found = false;
+    crate::ast_visitor::expr_visitor_walk(expr, &mut |expr| {
+        if matches!(expr.x, ExprX::NeverToAny(_)) {
+            return crate::ast_visitor::VisitorControlFlow::Return;
+        }
+        if typ_is_rust_uninhabited(&expr.typ, datatypes) {
+            found = true;
+            return crate::ast_visitor::VisitorControlFlow::Stop(());
+        }
+        crate::ast_visitor::VisitorControlFlow::Recurse
+    });
+    found
+}
+
+fn expr_contains_never_to_any_or_uninhabited_typ(
+    expr: &Expr,
+    datatypes: &HashMap<Path, Datatype>,
+) -> bool {
+    let mut found = false;
+    crate::ast_visitor::expr_visitor_walk(expr, &mut |expr| {
+        if matches!(expr.x, ExprX::NeverToAny(_))
+            || typ_is_rust_uninhabited(&expr.typ, datatypes)
+        {
+            found = true;
+            return crate::ast_visitor::VisitorControlFlow::Stop(());
+        }
+        crate::ast_visitor::VisitorControlFlow::Recurse
+    });
+    found
+}
+
+fn call_target_is_ghost(call_target: &CallTarget, functions: &HashMap<Fun, Function>) -> bool {
+    match call_target {
+        CallTarget::Fun(kind, fun, _, _, _, _) => match kind {
+            CallTargetKind::ProofFn(_, ret_mode) => *ret_mode != Mode::Exec,
+            _ => functions
+                .get(fun)
+                .map(|f| f.x.mode != Mode::Exec)
+                .unwrap_or(false),
+        },
+        CallTarget::FnSpec(_) | CallTarget::BuiltinSpecFun(..) => true,
+    }
+}
+
+fn place_root_is_ghost(place: &Place, var_modes: &HashMap<VarIdent, Mode>) -> bool {
+    match &place.x {
+        PlaceX::Local(var_ident) => {
+            var_modes.get(var_ident).map(|m| *m != Mode::Exec).unwrap_or(false)
+        }
+        PlaceX::Field(_, place)
+        | PlaceX::DerefMut(place)
+        | PlaceX::ModeUnwrap(place, _)
+        | PlaceX::UserDefinedTypInvariantObligation(place, _) => {
+            place_root_is_ghost(place, var_modes)
+        }
+        PlaceX::WithExpr(_, place) => place_root_is_ghost(place, var_modes),
+        PlaceX::Temporary(_) | PlaceX::Index(..) => false,
+    }
+}
+
+fn expr_contains_ghost_uninhabited_source(
+    expr: &Expr,
+    datatypes: &HashMap<Path, Datatype>,
+    functions: &HashMap<Fun, Function>,
+    var_modes: &HashMap<VarIdent, Mode>,
+) -> bool {
+    let mut found = false;
+    crate::ast_visitor::expr_visitor_walk(expr, &mut |expr| {
+        if typ_is_rust_uninhabited(&expr.typ, datatypes) {
+            let is_ghost_source = match &expr.x {
+                ExprX::Call(call_target, _, _) => call_target_is_ghost(call_target, functions),
+                ExprX::ReadPlace(place, _) => place_root_is_ghost(place, var_modes),
+                ExprX::Var(var_ident)
+                | ExprX::VarLoc(var_ident)
+                | ExprX::VarAt(var_ident, _) => {
+                    var_modes.get(var_ident).map(|m| *m != Mode::Exec).unwrap_or(false)
+                }
+                ExprX::ConstVar(..) | ExprX::StaticVar(_) => true,
+                _ => false,
+            };
+            if is_ghost_source {
+                found = true;
+                return crate::ast_visitor::VisitorControlFlow::Stop(());
+            }
+        }
+        crate::ast_visitor::VisitorControlFlow::Recurse
+    });
+    found
+}
+
+fn check_duplicate_preliminary_moves(expr: &Expr) -> Result<(), VirErr> {
+    fn place_root(place: &Place) -> Option<VarIdent> {
+        match &place.x {
+            PlaceX::Local(var_ident) => Some(var_ident.clone()),
+            PlaceX::Field(_, place)
+            | PlaceX::DerefMut(place)
+            | PlaceX::ModeUnwrap(place, ModeWrapperMode::Proof)
+            | PlaceX::UserDefinedTypInvariantObligation(place, _) => place_root(place),
+            PlaceX::ModeUnwrap(_, ModeWrapperMode::Spec) | PlaceX::Temporary(_) => None,
+            PlaceX::WithExpr(_, place) => place_root(place),
+            PlaceX::Index(place, _, _, _) => place_root(place),
+        }
+    }
+
+    let mut seen: HashSet<VarIdent> = HashSet::new();
+    let mut result = Ok(());
+    crate::ast_visitor::expr_visitor_walk(expr, &mut |expr| {
+        if result.is_err() {
+            return crate::ast_visitor::VisitorControlFlow::Stop(());
+        }
+        if let ExprX::ReadPlace(place, read_kind) = &expr.x {
+            if matches!(read_kind.preliminary_kind, ReadKind::Move) {
+                if let Some(var_ident) = place_root(place) {
+                    let name = LocalName::Named(var_ident.clone());
+                    if !is_generated_tmp_local(&name) && !seen.insert(var_ident.clone()) {
+                        result = Err(error(
+                            &expr.span,
+                            format!(
+                                "use of possibly moved value `{}`",
+                                crate::def::user_local_name(&var_ident)
+                            ),
+                        ));
+                        return crate::ast_visitor::VisitorControlFlow::Stop(());
+                    }
+                }
+            }
+        }
+        crate::ast_visitor::VisitorControlFlow::Recurse
+    });
+    result
+}
+
+#[derive(Clone, PartialEq, Eq)]
+enum MoveProjectionKey {
+    Field(Dt, Ident, Ident),
+    DerefMut,
+    Index,
+}
+
+#[derive(Clone)]
+struct MovePlaceKey {
+    root: VarIdent,
+    projections: Vec<MoveProjectionKey>,
+}
+
+#[derive(Clone)]
+struct NeverTailState {
+    seen_ghost_never: bool,
+    moved: Vec<MovePlaceKey>,
+}
+
+fn check_never_tail_uses(
+    expr: &Expr,
+    datatypes: &HashMap<Path, Datatype>,
+    functions: &HashMap<Fun, Function>,
+    var_modes: &HashMap<VarIdent, Mode>,
+) -> Result<(), VirErr> {
+    fn call_target_is_ghost(
+        call_target: &CallTarget,
+        functions: &HashMap<Fun, Function>,
+    ) -> bool {
+        match call_target {
+            CallTarget::Fun(kind, fun, _, _, _, _) => match kind {
+                CallTargetKind::ProofFn(_, ret_mode) => *ret_mode != Mode::Exec,
+                _ => functions.get(fun).map(|f| f.x.mode != Mode::Exec).unwrap_or(false),
+            },
+            CallTarget::FnSpec(_) | CallTarget::BuiltinSpecFun(..) => true,
+        }
+    }
+
+    fn place_root_is_ghost(place: &Place, var_modes: &HashMap<VarIdent, Mode>) -> bool {
+        match &place.x {
+            PlaceX::Local(var_ident) => {
+                var_modes.get(var_ident).map(|m| *m != Mode::Exec).unwrap_or(false)
+            }
+            PlaceX::Field(_, place)
+            | PlaceX::DerefMut(place)
+            | PlaceX::ModeUnwrap(place, _)
+            | PlaceX::UserDefinedTypInvariantObligation(place, _) => {
+                place_root_is_ghost(place, var_modes)
+            }
+            PlaceX::WithExpr(_, place) => place_root_is_ghost(place, var_modes),
+            PlaceX::Temporary(_) | PlaceX::Index(..) => false,
+        }
+    }
+
+    fn expr_is_ghost_never_source(
+        expr: &Expr,
+        datatypes: &HashMap<Path, Datatype>,
+        functions: &HashMap<Fun, Function>,
+        var_modes: &HashMap<VarIdent, Mode>,
+    ) -> bool {
+        if !typ_is_rust_uninhabited(&expr.typ, datatypes) {
+            return false;
+        }
+        match &expr.x {
+            ExprX::Call(call_target, _, _) => call_target_is_ghost(call_target, functions),
+            ExprX::ReadPlace(place, _) => place_root_is_ghost(place, var_modes),
+            ExprX::Var(var_ident) | ExprX::VarLoc(var_ident) | ExprX::VarAt(var_ident, _) => {
+                var_modes.get(var_ident).map(|m| *m != Mode::Exec).unwrap_or(false)
+            }
+            ExprX::ConstVar(..) | ExprX::StaticVar(_) => true,
+            _ => false,
+        }
+    }
+
+    fn place_key(place: &Place) -> Option<MovePlaceKey> {
+        fn push(place: &Place, projections: &mut Vec<MoveProjectionKey>) -> Option<VarIdent> {
+            match &place.x {
+                PlaceX::Local(var_ident) => Some(var_ident.clone()),
+                PlaceX::Field(field, place) => {
+                    let root = push(place, projections)?;
+                    projections.push(MoveProjectionKey::Field(
+                        field.datatype.clone(),
+                        field.variant.clone(),
+                        field.field.clone(),
+                    ));
+                    Some(root)
+                }
+                PlaceX::DerefMut(place) => {
+                    let root = push(place, projections)?;
+                    projections.push(MoveProjectionKey::DerefMut);
+                    Some(root)
+                }
+                PlaceX::ModeUnwrap(place, ModeWrapperMode::Proof)
+                | PlaceX::UserDefinedTypInvariantObligation(place, _) => push(place, projections),
+                PlaceX::ModeUnwrap(_, ModeWrapperMode::Spec) | PlaceX::Temporary(_) => None,
+                PlaceX::WithExpr(_, place) => push(place, projections),
+                PlaceX::Index(place, _, _, _) => {
+                    let root = push(place, projections)?;
+                    projections.push(MoveProjectionKey::Index);
+                    Some(root)
+                }
+            }
+        }
+
+        let mut projections = Vec::new();
+        let root = push(place, &mut projections)?;
+        let name = LocalName::Named(root.clone());
+        if is_generated_tmp_local(&name) {
+            None
+        } else {
+            Some(MovePlaceKey { root, projections })
+        }
+    }
+
+    fn places_overlap(a: &MovePlaceKey, b: &MovePlaceKey) -> bool {
+        if a.root != b.root {
+            return false;
+        }
+        let n = std::cmp::min(a.projections.len(), b.projections.len());
+        for i in 0..n {
+            match (&a.projections[i], &b.projections[i]) {
+                (
+                    MoveProjectionKey::Field(dt1, variant1, field1),
+                    MoveProjectionKey::Field(dt2, variant2, field2),
+                ) if dt1 != dt2 || variant1 != variant2 || field1 != field2 => {
+                    return false;
+                }
+                (MoveProjectionKey::Field(..), MoveProjectionKey::Field(..)) => {}
+                (MoveProjectionKey::DerefMut, MoveProjectionKey::DerefMut)
+                | (MoveProjectionKey::Index, MoveProjectionKey::Index) => {}
+                _ => return true,
+            }
+        }
+        true
+    }
+
+    fn record_move(state: &mut NeverTailState, place: &Place, span: &Span) -> Result<(), VirErr> {
+        let Some(key) = place_key(place) else {
+            return Ok(());
+        };
+        if state.seen_ghost_never {
+            for moved in state.moved.iter() {
+                if places_overlap(moved, &key) {
+                    return Err(error(
+                        span,
+                        format!(
+                            "use of possibly moved value `{}`",
+                            crate::def::user_local_name(&key.root)
+                        ),
+                    ));
+                }
+            }
+        }
+        state.moved.push(key);
+        Ok(())
+    }
+
+    fn merge_branch_states(base_seen: bool, branches: Vec<NeverTailState>) -> NeverTailState {
+        let seen_ghost_never =
+            base_seen || (branches.len() > 0 && branches.iter().all(|s| s.seen_ghost_never));
+        let mut moved = Vec::new();
+        for branch in branches {
+            moved.extend(branch.moved);
+        }
+        NeverTailState { seen_ghost_never, moved }
+    }
+
+    fn scan_stmt(
+        stmt: &Stmt,
+        state: &mut NeverTailState,
+        datatypes: &HashMap<Path, Datatype>,
+        functions: &HashMap<Fun, Function>,
+        var_modes: &HashMap<VarIdent, Mode>,
+    ) -> Result<(), VirErr> {
+        match &stmt.x {
+            StmtX::Expr(expr) => scan_expr(expr, state, datatypes, functions, var_modes),
+            StmtX::Decl { init, els, .. } => {
+                if let Some(init) = init {
+                    scan_place(init, state, datatypes, functions, var_modes)?;
+                }
+                if let Some(els) = els {
+                    scan_expr(els, state, datatypes, functions, var_modes)?;
+                }
+                Ok(())
+            }
+        }
+    }
+
+    fn scan_place(
+        place: &Place,
+        state: &mut NeverTailState,
+        datatypes: &HashMap<Path, Datatype>,
+        functions: &HashMap<Fun, Function>,
+        var_modes: &HashMap<VarIdent, Mode>,
+    ) -> Result<(), VirErr> {
+        match &place.x {
+            PlaceX::Field(_, place)
+            | PlaceX::DerefMut(place)
+            | PlaceX::ModeUnwrap(place, _)
+            | PlaceX::UserDefinedTypInvariantObligation(place, _) => {
+                scan_place(place, state, datatypes, functions, var_modes)
+            }
+            PlaceX::Temporary(expr) => scan_expr(expr, state, datatypes, functions, var_modes),
+            PlaceX::WithExpr(expr, place) => {
+                scan_expr(expr, state, datatypes, functions, var_modes)?;
+                scan_place(place, state, datatypes, functions, var_modes)
+            }
+            PlaceX::Index(place, idx, _, _) => {
+                scan_place(place, state, datatypes, functions, var_modes)?;
+                scan_expr(idx, state, datatypes, functions, var_modes)
+            }
+            PlaceX::Local(_) => Ok(()),
+        }
+    }
+
+    fn scan_exprs(
+        exprs: &Exprs,
+        state: &mut NeverTailState,
+        datatypes: &HashMap<Path, Datatype>,
+        functions: &HashMap<Fun, Function>,
+        var_modes: &HashMap<VarIdent, Mode>,
+    ) -> Result<(), VirErr> {
+        for expr in exprs.iter() {
+            scan_expr(expr, state, datatypes, functions, var_modes)?;
+        }
+        Ok(())
+    }
+
+    fn scan_expr(
+        expr: &Expr,
+        state: &mut NeverTailState,
+        datatypes: &HashMap<Path, Datatype>,
+        functions: &HashMap<Fun, Function>,
+        var_modes: &HashMap<VarIdent, Mode>,
+    ) -> Result<(), VirErr> {
+        match &expr.x {
+            ExprX::Const(_)
+            | ExprX::Var(_)
+            | ExprX::VarLoc(_)
+            | ExprX::VarAt(..)
+            | ExprX::ConstVar(..)
+            | ExprX::StaticVar(_)
+            | ExprX::NullaryOpr(_)
+            | ExprX::ExecFnByName(_)
+            | ExprX::AirStmt(_)
+            | ExprX::Nondeterministic => {}
+            ExprX::Loc(e)
+            | ExprX::Unary(_, e)
+            | ExprX::UnaryOpr(_, e)
+            | ExprX::AssertCompute(e, _)
+            | ExprX::Ghost { expr: e, .. }
+            | ExprX::ProofInSpec(e)
+            | ExprX::NeverToAny(e)
+            | ExprX::Old(e) => {
+                scan_expr(e, state, datatypes, functions, var_modes)?;
+            }
+            ExprX::Binary(_, e1, e2) | ExprX::BinaryOpr(_, e1, e2) => {
+                scan_expr(e1, state, datatypes, functions, var_modes)?;
+                scan_expr(e2, state, datatypes, functions, var_modes)?;
+            }
+            ExprX::Multi(_, exprs) | ExprX::ArrayLiteral(exprs) => {
+                scan_exprs(exprs, state, datatypes, functions, var_modes)?;
+            }
+            ExprX::Call(call_target, exprs, post_args) => {
+                if let CallTarget::FnSpec(e) = call_target {
+                    scan_expr(e, state, datatypes, functions, var_modes)?;
+                }
+                scan_exprs(exprs, state, datatypes, functions, var_modes)?;
+                if let Some(post_args) = post_args {
+                    scan_expr(post_args, state, datatypes, functions, var_modes)?;
+                }
+            }
+            ExprX::Ctor(_, _, fields, update) => {
+                for field in fields.iter() {
+                    scan_expr(&field.a, state, datatypes, functions, var_modes)?;
+                }
+                if let Some(update) = update {
+                    scan_place(&update.place, state, datatypes, functions, var_modes)?;
+                }
+            }
+            ExprX::Assign { lhs, rhs, .. } => {
+                scan_expr(rhs, state, datatypes, functions, var_modes)?;
+                scan_expr(lhs, state, datatypes, functions, var_modes)?;
+            }
+            ExprX::AssignToPlace { place, rhs, .. } => {
+                scan_expr(rhs, state, datatypes, functions, var_modes)?;
+                scan_place(place, state, datatypes, functions, var_modes)?;
+            }
+            ExprX::AssertAssume { expr: e, .. }
+            | ExprX::AssertAssumeUserDefinedTypeInvariant { expr: e, .. } => {
+                scan_expr(e, state, datatypes, functions, var_modes)?;
+            }
+            ExprX::AssertBy { proof, .. } | ExprX::AssertQuery { proof, .. } => {
+                scan_expr(proof, state, datatypes, functions, var_modes)?;
+            }
+            ExprX::If(cond, then_expr, else_expr) => {
+                scan_expr(cond, state, datatypes, functions, var_modes)?;
+                let after_cond = state.clone();
+                let mut then_state = after_cond.clone();
+                scan_expr(then_expr, &mut then_state, datatypes, functions, var_modes)?;
+                let mut else_state = after_cond.clone();
+                if let Some(else_expr) = else_expr {
+                    scan_expr(else_expr, &mut else_state, datatypes, functions, var_modes)?;
+                }
+                *state =
+                    merge_branch_states(after_cond.seen_ghost_never, vec![then_state, else_state]);
+            }
+            ExprX::Match(place, arms) => {
+                scan_place(place, state, datatypes, functions, var_modes)?;
+                let after_place = state.clone();
+                let mut branch_states = Vec::new();
+                for arm in arms.iter() {
+                    let mut arm_state = after_place.clone();
+                    scan_expr(&arm.x.guard, &mut arm_state, datatypes, functions, var_modes)?;
+                    scan_expr(&arm.x.body, &mut arm_state, datatypes, functions, var_modes)?;
+                    branch_states.push(arm_state);
+                }
+                *state = merge_branch_states(after_place.seen_ghost_never, branch_states);
+            }
+            ExprX::Loop { body, cond, invs, decrease, .. } => {
+                if let Some(cond) = cond {
+                    scan_expr(cond, state, datatypes, functions, var_modes)?;
+                }
+                let mut loop_state = NeverTailState { seen_ghost_never: false, moved: Vec::new() };
+                scan_expr(body, &mut loop_state, datatypes, functions, var_modes)?;
+                for inv in invs.iter() {
+                    scan_expr(&inv.inv, &mut loop_state, datatypes, functions, var_modes)?;
+                }
+                scan_exprs(decrease, &mut loop_state, datatypes, functions, var_modes)?;
+            }
+            ExprX::OpenInvariant(arg, _, body, _) => {
+                scan_expr(arg, state, datatypes, functions, var_modes)?;
+                scan_expr(body, state, datatypes, functions, var_modes)?;
+            }
+            ExprX::Return(e) => {
+                if let Some(e) = e {
+                    scan_expr(e, state, datatypes, functions, var_modes)?;
+                }
+            }
+            ExprX::BreakOrContinue { .. } => {}
+            ExprX::Block(stmts, body) => {
+                for stmt in stmts.iter() {
+                    scan_stmt(stmt, state, datatypes, functions, var_modes)?;
+                }
+                if let Some(body) = body {
+                    scan_expr(body, state, datatypes, functions, var_modes)?;
+                }
+            }
+            ExprX::BorrowMut(place)
+            | ExprX::TwoPhaseBorrowMut(place)
+            | ExprX::ImplicitReborrowOrSpecRead(place, _, _) => {
+                scan_place(place, state, datatypes, functions, var_modes)?;
+            }
+            ExprX::ReadPlace(place, read_kind) => {
+                scan_place(place, state, datatypes, functions, var_modes)?;
+                if matches!(read_kind.preliminary_kind, ReadKind::Move) {
+                    record_move(state, place, &expr.span)?;
+                }
+            }
+            ExprX::EvalAndResolve(e1, e2) => {
+                scan_expr(e1, state, datatypes, functions, var_modes)?;
+                scan_expr(e2, state, datatypes, functions, var_modes)?;
+            }
+            ExprX::Quant(..)
+            | ExprX::Closure(..)
+            | ExprX::NonSpecClosure { .. }
+            | ExprX::Choose { .. }
+            | ExprX::WithTriggers { .. }
+            | ExprX::Fuel(..)
+            | ExprX::RevealString(_)
+            | ExprX::Header(_) => {}
+        }
+
+        if expr_is_ghost_never_source(expr, datatypes, functions, var_modes) {
+            state.seen_ghost_never = true;
+        }
+        Ok(())
+    }
+
+    let mut state = NeverTailState { seen_ghost_never: false, moved: Vec::new() };
+    scan_expr(expr, &mut state, datatypes, functions, var_modes)
+}
