+fn check_uses_initialized(cfg: &CFG, body_span: &Span) -> Result<(), VirErr> {
+    let move_places = cfg.locals.places_skip_insides_of_mut_refs();
+    let move_analyses: Vec<DataflowOutput<MovePossibilities>> =
+        move_places
+            .iter()
+            .map(|place| {
+                do_dataflow::<MovePossibilities>(
+                    cfg,
+                    MovePossibilities::empty(),
+                    MovePossibilities::entry(),
+                    place,
+                    Direction::Forward,
+                )
+            })
+            .collect();
+
+    for (bb_idx, bb) in cfg.basic_blocks.iter().enumerate() {
+        for (instr_idx, instr) in bb.instructions.iter().enumerate() {
+            let place = match &instr.kind {
+                InstructionKind::MoveFrom(place) => place,
+                InstructionKind::Mutate(_)
+                | InstructionKind::Overwrite(_)
+                | InstructionKind::DropFrom(_) => continue,
+            };
+            if cfg.locals.locals[place.local].name.is_temp() {
+                continue;
+            }
+            if is_generated_tmp_local(&cfg.locals.locals[place.local].name) {
+                continue;
+            }
+
+            for (move_place, analysis) in move_places.iter().zip(move_analyses.iter()) {
+                if cfg.locals.locals[move_place.local].name.is_temp() {
+                    continue;
+                }
+                if is_generated_tmp_local(&cfg.locals.locals[move_place.local].name) {
+                    continue;
+                }
+                if place.contains(move_place) && analysis.output[bb_idx][instr_idx].can_be_moved {
+                    let place_str = pretty_flattened_place(&cfg.locals, place);
+                    return Err(error(
+                        body_span,
+                        format!("use of possibly moved value `{}`", place_str),
+                    ));
+                }
+            }
+        }
+    }
+
+    Ok(())
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+struct MovePossibilities {
+    can_be_moved: bool,
+}
+
+impl DataflowState for MovePossibilities {
+    type Const = FlattenedPlace;
+
+    fn join(&mut self, b: &Self) {
+        *self = MovePossibilities { can_be_moved: self.can_be_moved || b.can_be_moved };
+    }
+
+    fn transfer(&self, instr: &Instruction, place: &FlattenedPlace) -> Self {
+        match &instr.kind {
+            InstructionKind::MoveFrom(sp) | InstructionKind::DropFrom(sp) => {
+                if sp.contains(place) {
+                    MovePossibilities { can_be_moved: true }
+                } else {
+                    *self
+                }
+            }
+            InstructionKind::Overwrite(sp) => {
+                if sp.contains(place) {
+                    MovePossibilities { can_be_moved: false }
+                } else {
+                    *self
+                }
+            }
+            InstructionKind::Mutate(_sp) => *self,
+        }
+    }
+}
+
+impl MovePossibilities {
+    fn empty() -> Self {
+        MovePossibilities { can_be_moved: false }
+    }
+
+    fn entry() -> Self {
+        MovePossibilities { can_be_moved: false }
+    }
+}
+
+fn is_generated_tmp_local(name: &LocalName) -> bool {
+    match name {
+        LocalName::Named(var_ident) => {
+            let name = crate::def::user_local_name(var_ident);
+            name == "verus_tmp" || name.starts_with("verus_tmp_")
+        }
+        LocalName::Temporary(..) => true,
+    }
+}
