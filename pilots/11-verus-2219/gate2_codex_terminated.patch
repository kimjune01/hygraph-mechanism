+pub(crate) fn check_uses_initialized_for_body(
+    params: &Params,
+    body: &Expr,
+    read_kind_finals: &ReadKindFinals,
+    datatypes: &HashMap<Path, Datatype>,
+    functions: &HashMap<Fun, Function>,
+    var_modes: &HashMap<VarIdent, Mode>,
+    temporary_modes: &HashMap<AstId, Mode>,
+) -> Result<(), VirErr> {
+    let mut scan_var_modes = var_modes.clone();
+    for p in params.iter() {
+        scan_var_modes.insert(p.x.name.clone(), p.x.mode);
+    }
+    if !expr_contains_ghost_uninhabited_source(body, datatypes, functions, &scan_var_modes) {
+        return Ok(());
+    }
+    check_duplicate_preliminary_moves(body)?;
+    let (cfg, _assigns_to_resolve, _typ_inv_obligations) = new_cfg_with_options(
+        params,
+        body,
+        read_kind_finals,
+        datatypes,
+        functions,
+        var_modes,
+        temporary_modes,
+        true,
+    )?;
+    check_uses_initialized(&cfg, &body.span)
+}
