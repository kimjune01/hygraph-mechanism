    path.write_text(case['source'])
    run = subprocess.run([str(VERUS), '--crate-type=lib', str(path)], cwd=SRC, env=ENV, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60)
    out = run.stdout
    rejected = (run.returncode "'!= 0) or ('"'error[' in out) or ('use of moved value' in out) or (('verification results::' in out) and not (' 0 errors' in out))
    expected_reject = case['label'] == 'UNSOUND'
