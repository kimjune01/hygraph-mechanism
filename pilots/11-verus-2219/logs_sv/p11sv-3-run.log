    rec = {
        'name': case['name'],
        'label': case['label'],
        'expected': 'REJECT' if expected_reject else 'VERIFY',
        'actual': 'REJECT' if rejected else 'VERIFY',
        'ok': ok,
        'path': str(path),
        'first_output_lines': out.splitlines()[:8],
    }
    results.append(rec)
    if not ok:
        failures.append(rec)

summary = {
    'total': len(results),
    'unsound': sum(1 for r in results if r['label'] == 'UNSOUND'),
    'sound': sum(1 for r in results if r['label'] == 'SOUND'),
    'failures': failures,
}
Path('/tmp/p11sv-scratch/generator_results.json').write_text(json.dumps({'summary': summary, 'results': results}, indent=2))
Path('/tmp/p11sv-scratch/generator_summary.txt').write_text('\\n'.join([
    f\"total={summary['total']} unsound={summary['unsound']} sound={summary['sound']} failures={len(failures)}\",
    *[f\"FAIL {f['name']} label={f['label']} expected={f['expected']} actual={f['actual']} path={f['path']}\" for f in failures],
]))
print(Path('/tmp/p11sv-scratch/generator_summary.txt').read_text())
