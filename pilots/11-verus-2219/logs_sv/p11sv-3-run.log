+pub(crate) fn is_erased_ghost_value_fn(def_id: DefId) -> bool {
+    let Some(erasure_ctxt) = get_verus_erasure_ctxt_option() else {
+        return false;
+    };
+    def_id == erasure_ctxt.erased_ghost_value_fn_def_id
+}
