s=s.replace(\"'call_arg': lambda ty, e: f\\\"take_any::<{ty}>({e});\\\",\", \"'call_arg': lambda ty, e: f\\\"take_never({e});\\\" if ty == '"'!'"' else f\\\"take_any::<{ty}>({e});\\\",\")
s=s.replace(\"    expr = pfn(ty)\\n    ghost_use = wrapfn(usefn(ty, expr))\", \"    if uname == 'let_ghost' and ty == '"'!'"':\\n        continue\\n    expr = pfn(ty)\\n    ghost_use = wrapfn(usefn(ty, expr))\")
s=s.replace(\"'''proof fn valid_single<T>(tracked t: T) {\\n    take_any::<"'!>(arbitrary::<!>());'"\\n    consume(t);\\n}\\n'''\", \"'''proof fn valid_single<T>(tracked t: T) {\\n    take_never(arbitrary::<"'!>());'"\\n    consume(t);\\n}\\n'''\")
s=s.replace(\",\\n    'valid_no_ghost_double_unreachable_match': '''proof fn valid_match_unreachable<T>(tracked t: T, nvr: "'!) {'"\\n    match nvr { }\\n    consume(t);\\n    consume(t);\\n}\\n'''\", \"\")
p.write_text(s)
