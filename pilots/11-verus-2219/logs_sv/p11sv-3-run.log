    fn dump_for_debugging(&self) {
        let mut body = Body::new(
            MirSource::item(self.def_id.to_def_id()),
            self.cfg.basic_blocks.clone(),
            self.source_scopes.clone(),
            self.local_decls.clone(),
            self.canonical_user_type_annotations.clone(),
