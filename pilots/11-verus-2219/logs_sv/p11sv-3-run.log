#![allow(unreachable_code)]
#![feature(never_type)]
use vstd::prelude::*;

verus! {
enum Void {}
struct Wrap<T> { tracked x: T }
proof fn take_never(nvr: !) { }
proof fn take_void(v: Void) { }
proof fn consume<T>(tracked t: T) { }
uninterp spec fn arbitrary<T>() -> T;
spec fn spec_never() -> ! { arbitrary() }
spec fn spec_void() -> Void { arbitrary() }
'"'''

PRODUCERS = {
    'arb_never': ('"'!'"', 'arbitrary::<"'!>()'"'),
    'spec_never': ('"'!'"', 'spec_never()'),
    'block_never': ('"'!'"', '{ arbitrary::<"'!>() }'"'),
    'arb_void': ('Void', 'arbitrary::<Void>()'),
    'spec_void': ('Void', 'spec_void()'),
    'block_void': ('Void', '{ arbitrary::<Void>() }'),
}

USES = {
    'call_arg': lambda ty, e: f\"take_{'never' if ty == '"'!'"' else 'void'}({e});\",
    'stmt': lambda ty, e: f\"{e};\",
    'let_ghost': lambda ty, e: f\"let ghost _x: {ty} = {e};\",
    'nested_block_stmt': lambda ty, e: f\"{{ {e}; }}\",
    'if_then': lambda ty, e: f\"if true {{ {e}; }}\",
    'match_bool_arm': lambda ty, e: f\"match true {{ true => {{ {e}; }}, false => {{ }} }}\",
}

WRAPPERS = {
    'plain': lambda s: s,
    'outer_block': lambda s: '{\\n        ' + s + '\\n    }',
    'before_if': lambda s: 'if true { }\\n    ' + s,
}

RESOURCES = {
    'generic': ('<T>', 'tracked t: T', 't'),
    'tuple_generic': ('<A, B>', 'tracked t: (A, B)', 't'),
    'wrap_generic': ('<T>', 'tracked t: Wrap<T>', 't'),
}

VALID_PROBES = {
    'valid_single_after_ghost': '''proof fn valid_single<T>(tracked t: T) {
    take_never(arbitrary::<"'!>());
    consume(t);
}
'"''',
    'valid_real_return_unreachable': '''proof fn valid_return_unreachable<T>(tracked t: T) {
    return;
    consume(t);
    consume(t);
}
''',
    'valid_no_ghost_double_unreachable_match': '''proof fn valid_match_unreachable<T>(tracked t: T, nvr: "'!) {
    match nvr { }
    consume(t);
    consume(t);
}
'"''',
}

cases = []
for (pname, (ty, expr)), (uname, usefn), (wname, wrapfn), (rname, (gens, param, var)) in itertools.product(
    PRODUCERS.items(), USES.items(), WRAPPERS.items(), RESOURCES.items()
):
    # "'`if true { arbitrary::<!>(); }` has type () but contains a diverging erased child; it exercises
    # the same erased-placeholder edge under a control-flow construct.
    ghost_use = wrapfn(usefn(ty, expr))
    body = f'"'''proof fn case_{pname}_{uname}_{wname}_{rname}{gens}({param}) {{
    {ghost_use}
    consume({var});
    consume({var});
}}
'''
    cases.append({
        'name': f'unsound_{pname}_{uname}_{wname}_{rname}',
        'label': 'UNSOUND',
        'source': COMMON + body + '}\\n\\nfn main() {}\\n',
    })

for name, body in VALID_PROBES.items():
    cases.append({'name': name, 'label': 'SOUND', 'source': COMMON + body + '}\\n\\nfn main() {}\\n'})

build = subprocess.run(['bash', '-c', 'vargo build --release'], cwd=SRC, env=ENV, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
(Path('/tmp/p11sv-scratch/generator_build.log')).write_text(build.stdout)
if build.returncode "'!= 0:
