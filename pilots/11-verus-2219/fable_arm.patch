+/// Decides whether the MIR builder must treat the given THIR call as total
+/// (non-diverging) even if its return type is uninhabited.
+///
+/// In Verus semantics ghost (spec/proof) code is total: every type is inhabited at
+/// the SMT level, so the code following a ghost expression of an uninhabited type
+/// (e.g. `!`) is still verified and must therefore still be borrow-checked. Cutting
+/// the control-flow edge after such a call would hide subsequent code from the
+/// borrow checker, breaking linearity checking of tracked values
+/// (https://github.com/verus-lang/verus/issues/2219).
+///
+/// Returns true when the call is:
+///  - a call to `erased_ghost_value` (the stand-in for erased ghost code), or
+///  - a fake call whose callee is itself an erased ghost value (closure-capture
+///    coercions and FnProof calls are encoded this way), or
+///  - any call inside a body that is entirely ghost (spec/proof fn or closure), or
+///  - a call that mode checking resolved as a spec/proof-mode call.
+///
+/// Exec calls keep Rust's normal control-flow rules: an exec call with an
+/// uninhabited return type really does diverge.
+pub(crate) fn call_never_diverges<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    thir: &rustc_middle::thir::Thir<'tcx>,
+    body_def_id: LocalDefId,
+    body_owner: rustc_hir::OwnerId,
+    fun: ExprId,
+    call_temp_scope_id: hir::ItemLocalId,
+) -> bool {
+    let Some(erasure_ctxt) = get_verus_erasure_ctxt_option() else {
+        return false;
+    };
+    if !erasure_active_for_body(tcx, body_def_id) {
+        return false;
+    }
+
+    // Calls to erased_ghost_value stand in for erased ghost code.
+    if let TyKind::FnDef(fn_def_id, _) = thir.exprs[fun].ty.kind() {
+        if *fn_def_id == erasure_ctxt.erased_ghost_value_fn_def_id {
+            return true;
+        }
+    }
+
+    // Fake calls synthesized by erasure (e.g., closure-capture coercions) use an
+    // erased ghost value as the callee.
+    if is_erased_in_thir(thir, &erasure_ctxt, &thir.exprs[fun].kind) {
+        return true;
+    }
+
+    // Bodies that consist entirely of ghost code.
+    if matches!(erasure_ctxt.bodies.get(&body_def_id), Some(BodyErasure { ghost: true, .. })) {
+        return true;
+    }
+
+    // Calls that mode checking resolved as ghost (spec/proof-mode) calls.
+    let call_hir_id = HirId { owner: body_owner, local_id: call_temp_scope_id };
+    matches!(
+        erasure_ctxt.calls.get(&call_hir_id),
+        Some(CallErasure::Call(_, CallGhostness::Ghost))
+    )
+}
+
+/// Like `is_erased`, but usable after THIR building (from the MIR builder).
+fn is_erased_in_thir<'tcx>(
+    thir: &rustc_middle::thir::Thir<'tcx>,
+    erasure_ctxt: &VerusErasureCtxt,
+    expr_kind: &rustc_middle::thir::ExprKind<'tcx>,
+) -> bool {
+    match expr_kind {
+        ExprKind::Call { fun, args: _, .. } => match thir.exprs[*fun].ty.kind() {
+            TyKind::FnDef(fn_def_id, _) => *fn_def_id == erasure_ctxt.erased_ghost_value_fn_def_id,
+            _ => false,
+        },
+        ExprKind::Scope { region_scope: _, lint_level: _, value } => {
+            is_erased_in_thir(thir, erasure_ctxt, &thir.exprs[*value].kind)
         }
+        _ => false,
     }
 }
 
