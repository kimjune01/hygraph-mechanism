+/// Is Verus erasure being applied to the given body? (i.e., are we building the
+/// program used for ghost lifetime checking, and is this body one that Verus checks?)
+pub(crate) fn erasure_active_for_body<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    body_def_id: LocalDefId,
+) -> bool {
+    if get_verus_erasure_ctxt_option().is_none() {
+        return false;
+    }
+    let fn_local_def_id = enclosing_fn_local_def_id(tcx, body_def_id);
+    match VERUS_AWARE_DEF_IDS.read().unwrap().clone() {
+        Some(ids) => ids.contains(&fn_local_def_id),
+        None => false,
+    }
