+pub(crate) fn is_erased_ghost_value_call<'tcx>(func: &rustc_middle::mir::Operand<'tcx>) -> bool {
+    let Some(erasure_ctxt) = get_verus_erasure_ctxt_option() else {
+        return false;
+    };
+    match func {
+        rustc_middle::mir::Operand::Constant(c) => match c.const_.ty().kind() {
+            TyKind::FnDef(fn_def_id, _) => *fn_def_id == erasure_ctxt.erased_ghost_value_fn_def_id,
+            _ => false,
+        },
+        _ => false,
+    }
+}
+
+fn erased_ghost_value_args<'tcx>(
+    cx: &ThirBuildCx<'tcx>,
+    erasure_ctxt: &VerusErasureCtxt,
+    expr_kind: &rustc_middle::thir::ExprKind<'tcx>,
+) -> Option<Vec<ExprId>> {
+    match expr_kind {
+        ExprKind::Call { fun, args, .. } => match cx.thir.exprs[*fun].ty.kind() {
+            TyKind::FnDef(fn_def_id, _)
+                if *fn_def_id == erasure_ctxt.erased_ghost_value_fn_def_id =>
+            {
+                let tup_arg = args[0];
+                match &cx.thir.exprs[tup_arg].kind {
+                    ExprKind::Tuple { fields } => Some(fields.clone().into_vec()),
+                    _ => panic!(
+                        "erased_ghost_value should only be constructed with a tuple argument"
+                    ),
+                }
+            }
+            _ => None,
+        },
+        ExprKind::Scope { region_scope: _, lint_level: _, value } => {
+            erased_ghost_value_args(cx, erasure_ctxt, &cx.thir.exprs[*value].kind)
+        }
+        _ => None,
+    }
+}
+
+pub(crate) fn erase_never_to_any_if_erased<'tcx>(
+    cx: &mut ThirBuildCx<'tcx>,
+    erasure_ctxt: &VerusErasureCtxt,
+    hir_id: HirId,
+    span: Span,
+    target_ty: Ty<'tcx>,
+    expr_kind: &rustc_middle::thir::ExprKind<'tcx>,
+) -> Option<rustc_middle::thir::ExprKind<'tcx>> {
+    let ExprKind::NeverToAny { source } = expr_kind else {
+        return None;
+    };
+    let source_kind = &cx.thir.exprs[*source].kind;
+    let args = erased_ghost_value_args(cx, erasure_ctxt, source_kind)?;
+    Some(erased_ghost_value_kind_with_args(cx, erasure_ctxt, hir_id, span, target_ty, args))
+}
