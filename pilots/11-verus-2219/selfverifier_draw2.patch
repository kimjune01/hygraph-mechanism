+pub(crate) fn is_erased_ghost_value_call<'tcx>(
+    erasure_ctxt: &VerusErasureCtxt,
+    func: &rustc_middle::mir::Operand<'tcx>,
+) -> bool {
+    match func {
+        rustc_middle::mir::Operand::Constant(constant) => match constant.const_.ty().kind() {
+            TyKind::FnDef(fn_def_id, _) => *fn_def_id == erasure_ctxt.erased_ghost_value_fn_def_id,
+            _ => false,
+        },
+        _ => false,
+    }
+}
+
+pub(crate) fn erased_ghost_value_args<'tcx>(
+    thir: &rustc_middle::thir::Thir<'tcx>,
+    erasure_ctxt: &VerusErasureCtxt,
+    expr_id: ExprId,
+) -> Option<Vec<ExprId>> {
+    match &thir.exprs[expr_id].kind {
+        ExprKind::Call { fun, args, .. } => match thir.exprs[*fun].ty.kind() {
+            TyKind::FnDef(fn_def_id, _)
+                if *fn_def_id == erasure_ctxt.erased_ghost_value_fn_def_id =>
+            {
+                let tup_arg = args[0];
+                match &thir.exprs[tup_arg].kind {
+                    ExprKind::Tuple { fields } => Some(fields.iter().copied().collect()),
+                    _ => None,
+                }
+            }
+            _ => None,
+        },
+        ExprKind::NeverToAny { source } => erased_ghost_value_args(thir, erasure_ctxt, *source),
+        ExprKind::Scope { value, .. } => erased_ghost_value_args(thir, erasure_ctxt, *value),
+        _ => None,
+    }
+}
+
+pub(crate) fn erased_ghost_value_is_never<'tcx>(
+    thir: &rustc_middle::thir::Thir<'tcx>,
+    erasure_ctxt: &VerusErasureCtxt,
+    expr_id: ExprId,
+) -> bool {
+    match &thir.exprs[expr_id].kind {
+        ExprKind::NeverToAny { source } => erased_ghost_value_is_never(thir, erasure_ctxt, *source),
+        ExprKind::Scope { value, .. } => erased_ghost_value_is_never(thir, erasure_ctxt, *value),
+        _ => {
+            erased_ghost_value_args(thir, erasure_ctxt, expr_id).is_some()
+                && thir.exprs[expr_id].ty.is_never()
+        }
+    }
+}
+
+pub(crate) fn is_zst_fn_def<'tcx>(thir: &rustc_middle::thir::Thir<'tcx>, expr_id: ExprId) -> bool {
+    match &thir.exprs[expr_id].kind {
+        ExprKind::Scope { value, .. } => is_zst_fn_def(thir, *value),
+        ExprKind::ZstLiteral { .. } => matches!(thir.exprs[expr_id].ty.kind(), TyKind::FnDef(..)),
+        _ => false,
+    }
+}
