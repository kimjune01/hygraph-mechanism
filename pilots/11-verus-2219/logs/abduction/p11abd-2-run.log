+pub(crate) fn is_erased_ghost_value_fn(def_id: DefId) -> bool {
+    match get_verus_erasure_ctxt_option() {
+        Some(erasure_ctxt) => def_id == erasure_ctxt.erased_ghost_value_fn_def_id,
+        None => false,
+    }
