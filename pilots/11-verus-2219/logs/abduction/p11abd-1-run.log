pub(crate) fn get_closure_expr<'tcx>(e: &'tcx hir::Expr<'tcx>) -> &'tcx hir::Expr<'tcx> {
    match &e.kind {
        hir::ExprKind::Closure(_) => e,
        hir::ExprKind::Call(_f, args) => get_closure_expr(&args[0]),
        _ => panic!("get_closure_expr failed"),
    }
}

/// Generate a fake function call by using 'erased_ghost_value' to create the *function*
/// then call the function.
pub(crate) fn make_fake_call<'tcx>(
    cx: &mut ThirBuildCx<'tcx>,
    erasure_ctxt: &VerusErasureCtxt,
    hir_id: HirId,
    span: Span,
    fn_ty: Ty<'tcx>,
    args: Vec<ExprId>,
    result_ty: Ty<'tcx>,
) -> ExprId {
    let kind = make_fake_call_kind(cx, erasure_ctxt, hir_id, span, fn_ty, args);
    expr_id_from_kind(cx, kind, hir_id, span, result_ty)
}

pub(crate) fn make_fake_call_kind<'tcx>(
    cx: &mut ThirBuildCx<'tcx>,
    erasure_ctxt: &VerusErasureCtxt,
    hir_id: HirId,
    span: Span,
    fn_ty: Ty<'tcx>,
    args: Vec<ExprId>,
) -> ExprKind<'tcx> {
    let f = erased_ghost_value(cx, erasure_ctxt, hir_id, span, fn_ty);

    ExprKind::Call {
        ty: fn_ty,
        fun: f,
        args: args.into_boxed_slice(),
        from_hir_call: false,
        fn_span: span,
    }
}

pub(crate) fn make_fake_call_kind_with_original_fn<'tcx>(
    cx: &mut ThirBuildCx<'tcx>,
    erasure_ctxt: &VerusErasureCtxt,
    hir_id: HirId,
    span: Span,
    fn_ty: Ty<'tcx>,
    original_fn: ExprId,
    args: Vec<ExprId>,
) -> ExprKind<'tcx> {
    let f = erased_ghost_value_with_args(cx, erasure_ctxt, hir_id, span, fn_ty, vec![original_fn]);

    ExprKind::Call {
        ty: fn_ty,
        fun: f,
        args: args.into_boxed_slice(),
        from_hir_call: false,
        fn_span: span,
    }
}

