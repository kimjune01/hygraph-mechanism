@@ -843,9 +843,39 @@ impl<'a, 'tcx> Builder<'a, 'tcx> {
     fn lint_and_remove_uninhabited(&mut self) {
         let mut lints = vec![];
 
+        // (Note from verus) In the verus ghost-keep compilation pass, proof/ghost code is
+        // kept for borrow-checking purposes while spec code is erased to `erased_ghost_value`
+        // placeholders. A call that returns an uninhabited type (e.g. `!`) in a PROOF function
+        // body is a GHOST return — it does not represent real Rust-level divergence. Removing
+        // the return edge would make subsequent MIR blocks unreachable to the borrow-checker,
+        // allowing double-consumption of `tracked` (affine/linear) resources to slip through
+        // undetected — a soundness bug (issue #2219).
+        //
+        // Fix: when the current function is a verus proof function AND the callee is either:
+        //   (a) erased_ghost_value (a ghost erasure placeholder), OR
+        //   (b) a locally-defined proof function (not from an external crate),
+        // suppress `*target = None`. This keeps the return edge visible so the borrow-checker
+        // enforces linearity on tracked resources after the call.
+        //
+        // We do NOT suppress for calls to external proof fns like `proof_from_false`
+        // (which requires false — its callers are logically unreachable, making the
+        // post-call code genuinely unreachable in any sound proof).
+        //
+        // Exec functions are NOT affected: real Rust divergence (panic!, etc.) still removes
+        // return edges for exec fn bodies, preserving existing borrow-check behaviour.
+        let ctxt_opt = crate::verus::get_verus_erasure_ctxt_option();
+        let in_verus_proof_fn = ctxt_opt
+            .as_ref()
+            .and_then(|ctxt| ctxt.bodies.get(&self.def_id).copied())
+            .is_some_and(|b| b.is_proof);
+        let erased_ghost_value_def_id = self.tcx.get_diagnostic_item(
+            Symbol::intern("verus::verus_builtin::erased_ghost_value"),
+        );
+
         for bbdata in self.cfg.basic_blocks.iter_mut() {
             let term = bbdata.terminator_mut();
-            let TerminatorKind::Call { ref mut target, destination, .. } = term.kind else {
+            let TerminatorKind::Call { ref mut target, destination, ref func, .. } = term.kind
+            else {
                 continue;
             };
             let Some(target_bb) = *target else { continue };
@@ -890,11 +920,32 @@ impl<'a, 'tcx> Builder<'a, 'tcx> {
                     lints.push((target_bb, ty, term.source_info.span));
                 }
 
-                // The presence or absence of a return edge affects control-flow sensitive
-                // MIR checks and ultimately whether code is accepted or not. We can only
-                // omit the return edge if a return type is visibly uninhabited to a module
-                // that makes the call.
-                *target = None;
+                // (Note from verus) In a proof fn body, suppress removing the return edge
+                // when the callee is a ghost erasure artifact (erased_ghost_value) OR a
+                // locally-defined proof function. External proof fns from vstd (like
+                // proof_from_false which requires false) legitimately cause unreachability
+                // and should still have the return edge removed.
+                let suppress_remove = in_verus_proof_fn && {
+                    let callee_ty = func.ty(&self.local_decls, self.tcx);
+                    if let ty::TyKind::FnDef(callee_def_id, _) = callee_ty.kind() {
+                        let is_erased_ghost =
+                            erased_ghost_value_def_id == Some(*callee_def_id);
+                        let is_local_proof_fn_without_req_false =
+                            callee_def_id.as_local().is_some_and(|local_id| {
+                                ctxt_opt
+                                    .as_ref()
+                                    .and_then(|c| c.bodies.get(&local_id).copied())
+                                    .is_some_and(|b| b.is_proof && !b.requires_false)
+                            });
+                        is_erased_ghost || is_local_proof_fn_without_req_false
+                    } else {
+                        false
+                    }
+                };
+
+                if !suppress_remove {
+                    *target = None;
+                }
             }
         }
 
