                 CallErasure::Call(NodeErase::Erase)
+            } else if *in_ghost && f.x.mode == Mode::Proof {
+                // A proof fn whose only tracked (proof-mode) params/return are of the
+                // uninhabited Never (!) type has no real linearity side effects when
+                // called from a ghost context: Never values can never exist at runtime,
+                // so there is no tracked resource that the borrow checker needs to see
+                // consumed.  Erasing such calls prevents ghost uses of the Never type
+                // from making subsequent code unreachable to the borrow checker, which
+                // would otherwise allow linear (tracked) resources to be used multiple
+                // times (issue #2219).
+                // A type is "linear" (carries borrow-check linearity) if it is
+                // neither Never (!) nor unit (): unit is always Copy/trivial, and
+                // Never cannot exist at runtime.  Note that proof fns with no
+                // explicit return type get ret.mode == function mode (Proof) but
+                // ret.typ == unit, which must also be treated as non-linear.
+                let is_trivial_typ = |typ: &vir::ast::Typ| {
+                    matches!(**(typ), TypX::Decorate(TypDecoration::Never, _, _))
+                        || matches!(**(typ), TypX::Datatype(Dt::Tuple(0), _, _))
+                };
+                let has_linear_tracked_param = f.x.params.iter().any(|p| {
+                    p.x.mode == Mode::Proof && !is_trivial_typ(&p.x.typ)
+                });
+                let has_linear_tracked_ret =
+                    f.x.ret.x.mode == Mode::Proof && !is_trivial_typ(&f.x.ret.x.typ);
+                if !has_linear_tracked_param && !has_linear_tracked_ret {
+                    CallErasure::Call(NodeErase::Erase)
+                } else {
+                    CallErasure::Call(NodeErase::Keep)
+                }
             } else {
                 CallErasure::Call(NodeErase::Keep)
             }
