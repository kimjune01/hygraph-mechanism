+/// Recursively check whether `expr_id` is a ghost/erased expression of type Never (!).
+/// Used to decide whether to drop such statements from proof fn bodies (issue #2219).
+fn is_ghost_never_inner<'tcx>(
+    cx: &ThirBuildCx<'tcx>,
+    erasure_ctxt: &VerusErasureCtxt,
+    expr_id: ExprId,
+) -> bool {
+    use rustc_middle::thir::ExprKind as EK;
+    let expr = &cx.thir.exprs[expr_id];
+    if !expr.ty.is_never() {
+        return false;
+    }
+    match &expr.kind {
+        EK::Scope { value, .. } => is_ghost_never_inner(cx, erasure_ctxt, *value),
+        EK::Call { .. } => is_erased(cx, erasure_ctxt, &expr.kind),
+        EK::Match { arms, .. } => arms.iter().all(|arm_id| {
+            let arm = &cx.thir.arms[*arm_id];
+            is_ghost_never_inner(cx, erasure_ctxt, arm.body)
+        }),
+        EK::Block { block } => {
+            let block = &cx.thir.blocks[*block];
+            if let Some(final_expr) = block.expr {
+                is_ghost_never_inner(cx, erasure_ctxt, final_expr)
+            } else {
+                false
+            }
+        }
+        _ => false,
+    }
+}
+
+/// Returns true if a standalone expression statement should be dropped because
+/// it is a ghost/erased expression of Never type that would cause the borrow
+/// checker to treat subsequent code as unreachable (issue #2219).
+pub(crate) fn is_ghost_never_expr_stmt<'tcx>(cx: &ThirBuildCx<'tcx>, expr_id: ExprId) -> bool {
+    let Some(erasure_ctxt) = cx.verus_ctxt.ctxt.as_deref() else {
+        return false;
+    };
+    is_ghost_never_inner(cx, erasure_ctxt, expr_id)
+}
+
+/// Returns true if a let statement should be dropped because both the pattern type
+/// and the initializer are ghost/erased Never-type expressions (issue #2219).
+pub(crate) fn is_ghost_never_let_stmt<'tcx>(
+    cx: &ThirBuildCx<'tcx>,
+    pattern: &Pat<'tcx>,
+    initializer: &Option<ExprId>,
+) -> bool {
+    let Some(init_id) = initializer else {
+        return false;
+    };
+    if !pattern.ty.is_never() || !cx.thir.exprs[*init_id].ty.is_never() {
+        return false;
+    }
+    let Some(erasure_ctxt) = cx.verus_ctxt.ctxt.as_deref() else {
+        return false;
+    };
+    is_ghost_never_inner(cx, erasure_ctxt, *init_id)
+}
