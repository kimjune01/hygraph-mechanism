+fn rust_ty_is_uninhabited<'tcx>(bctx: &BodyCtxt<'tcx>, ty: rustc_middle::ty::Ty<'tcx>) -> bool {
+    let tcx = bctx.ctxt.tcx;
+    let typing_env = TypingEnv::non_body_analysis(tcx, bctx.fun_id);
+    let module = match bctx.fun_id.as_local() {
+        Some(local_def_id) => tcx.parent_module(tcx.local_def_id_to_hir_id(local_def_id)).to_def_id(),
+        None => bctx.fun_id,
+    };
+    !ty.is_inhabited_from(tcx, module, typing_env)
+}
+
+fn mark_expr_or_place_uninhabited(vir: ExprOrPlace) -> ExprOrPlace {
+    let mark_typ = |typ: &Typ| -> Typ {
+        if matches!(&**typ, TypX::Decorate(TypDecoration::Never, _, _)) {
+            typ.clone()
+        } else {
+            Arc::new(TypX::Decorate(TypDecoration::Never, None, typ.clone()))
+        }
+    };
+    match vir {
+        ExprOrPlace::Expr(e) => {
+            let typ = mark_typ(&e.typ);
+            ExprOrPlace::Expr(SpannedTyped::new(&e.span, &typ, e.x.clone()))
+        }
+        ExprOrPlace::Place(p) => {
+            let typ = mark_typ(&p.typ);
+            ExprOrPlace::Place(SpannedTyped::new(&p.span, &typ, p.x.clone()))
+        }
+    }
+}
