+fn is_explicit_control_flow_exit(expr: &Expr) -> bool {
+    match &expr.x {
+        ExprX::Return(_) | ExprX::BreakOrContinue { .. } => true,
+        ExprX::Block(stmts, None) => match stmts.last() {
+            Some(stmt) => match &stmt.x {
+                StmtX::Expr(e) => is_explicit_control_flow_exit(e),
+                StmtX::Decl { els: Some(e), .. } => is_explicit_control_flow_exit(e),
+                StmtX::Decl { els: None, .. } => false,
+            },
+            None => false,
+        },
+        ExprX::Block(_, Some(e)) => is_explicit_control_flow_exit(e),
+        _ => false,
+    }
+}
+
+fn is_uninhabited_typ(ctxt: &Ctxt, typ: &Typ, visiting: &mut HashSet<Dt>) -> bool {
+    match &**typ {
+        TypX::Decorate(TypDecoration::Never, _, _) => true,
+        TypX::Decorate(_, _, inner) | TypX::Boxed(inner) => is_uninhabited_typ(ctxt, inner, visiting),
+        TypX::Datatype(dt, typ_args, _) => {
+            if matches!(dt, Dt::Tuple(_)) {
+                return typ_args.iter().any(|typ| is_uninhabited_typ(ctxt, typ, visiting));
+            }
+            if !visiting.insert(dt.clone()) {
+                return false;
+            }
+            let Dt::Path(path) = dt else {
+                unreachable!();
+            };
+            let name = path_as_friendly_rust_name(path);
+            if matches!(
+                name.as_str(),
+                "core::convert::Infallible" | "std::convert::Infallible"
+            ) {
+                visiting.remove(dt);
+                return true;
+            }
+            let result = match ctxt.datatypes.get(path) {
+                None => {
+                    false
+                }
+                Some(datatype) => {
+                    datatype.x.variants.len() == 0
+                        || datatype.x.variants.iter().all(|variant| {
+                            variant.fields.iter().any(|field| {
+                                let field_typ = subst_typ_for_datatype(
+                                    &datatype.x.typ_params,
+                                    typ_args,
+                                    &field.a.0,
+                                );
+                                is_uninhabited_typ(ctxt, &field_typ, visiting)
+                            })
+                        })
+                }
+            };
+            visiting.remove(dt);
+            result
+        }
+        _ => false,
+    }
+}
+
+fn reject_never_typed_ghost_expr_with_continuation(
+    ctxt: &Ctxt,
+    typing: &Typing,
+    expr: &Expr,
+    mode: Mode,
+) -> Result<(), VirErr> {
+    let mut visiting = HashSet::new();
+    if typing.reject_ghost_never_to_any
+        && mode != Mode::Exec
+        && is_uninhabited_typ(ctxt, &expr.typ, &mut visiting)
+        && !is_explicit_control_flow_exit(expr)
+    {
+        return Err(error(
+            &expr.span,
+            "never-typed ghost expressions are not allowed before later code",
+        ));
+    }
+    Ok(())
+}
+
+fn strip_extra_never_typ(typ: &Typ) -> Typ {
+    match &**typ {
+        TypX::Decorate(TypDecoration::Never, _, inner) if !is_unit(inner) => inner.clone(),
+        _ => typ.clone(),
+    }
+}
+
+fn strip_extra_never_expr_markers(function: &Function) -> Result<Function, VirErr> {
+    crate::ast_visitor::map_function_visitor_env(
+        function,
+        &mut ScopeMap::new(),
+        &mut (),
+        &|_, _, expr| {
+            let typ = strip_extra_never_typ(&expr.typ);
+            Ok(SpannedTyped::new(&expr.span, &typ, expr.x.clone()))
+        },
+        &|_, _, stmt| Ok(vec![stmt.clone()]),
+        &|_, typ| Ok(typ.clone()),
+        &|_, _, place| {
+            let typ = strip_extra_never_typ(&place.typ);
+            Ok(SpannedTyped::new(&place.span, &typ, place.x.clone()))
+        },
+    )
+}
