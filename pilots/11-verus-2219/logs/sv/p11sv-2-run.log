                if matches!(self.tcx.def_kind(self.def_id), DefKind::Fn | DefKind::AssocFn) {
                    self.tcx
                        .fn_sig(self.def_id)
                        .instantiate_identity()
                        .skip_binder()
                        .output()
                        .is_inhabited_from(
                            self.tcx,
                            self.parent_module,
                            self.infcx.typing_env(self.param_env),
                        )
                } else {
                    true
                };

            if !ty_is_inhabited {
