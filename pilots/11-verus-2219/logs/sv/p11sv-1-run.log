+#!/usr/bin/env python3
+import itertools
+import os
+import shutil
+import subprocess
+
+ROOT = "/Users/junekim/Documents/verus-p11"
+SRC = os.path.join(ROOT, "source")
+OUT = "/tmp/p11sv-scratch/generated"
+REPORT = "/tmp/p11sv-scratch/generator_report.txt"
+
+VALUE_CASES = [
+    ("never_to_never_fn", "!", "sink_never(arbitrary());"),
+    ("never_to_generic_explicit", "!", "sink_generic::<!>(arbitrary());"),
+    ("tuple_never_to_generic", "(!,)", "sink_generic::<(!,)>(arbitrary());"),
+    ("tuple_never_constructed", "(!,)", "sink_pair((arbitrary(),));"),
+    ("tuple_never_direct_pair", "(!,)", "sink_pair(arbitrary());"),
+    ("result_never_never", "Result<!, !>", "sink_generic::<Result<!, !>>(arbitrary());"),
+    ("result_never_unit", "Result<!, ()>", "sink_generic::<Result<!, ()>>(arbitrary());"),
+    ("option_never", "Option<!>", "sink_generic::<Option<!>>(arbitrary());"),
+]
+
+RESOURCES = [
+    ("generic", "T", "tracked t: T"),
+    ("tracked_struct", "Token", "tracked t: Token"),
+    ("tracked_tuple", "(Token, Token)", "tracked t: (Token, Token)"),
+]
+
+POSTS = [
+    ("double_consume", "consume(t);\n    consume(t);", "UNSOUND", "REJECT"),
+    ("single_consume", "consume(t);", "VALID", "ACCEPT"),
+    ("return_double_consume", "return;\n    consume(t);\n    consume(t);", "VALID", "ACCEPT"),
+]
+
+PRELUDE = """\
+#![allow(internal_features)]
+#![feature(rustc_attrs)]
+#![feature(never_type)]
+use vstd::prelude::*;
+
+verus! {
+proof fn sink_never(x: !) { }
+proof fn sink_pair(x: (!,)) { }
+proof fn sink_generic<X>(x: X) { }
+proof fn consume<X>(tracked x: X) { }
+uninterp spec fn arbitrary<X>() -> X;
+struct Token { v: int }
+"""
+
+def write_case(path, resource, value_stmt, post_stmt):
+    resource_ty, param = resource[1], resource[2]
+    generics = "<T>" if resource_ty == "T" else ""
+    body = PRELUDE
+    body += f"""
+proof fn case_fn{generics}({param}) {{
+    {value_stmt}
+    {post_stmt}
+}}
+}}
+fn main() {{}}
+"""
+    with open(path, "w") as f:
+        f.write(body)
+
+def accepted(output):
+    return " 0 errors" in output and "error[" not in output and "error:" not in output
+
+def main():
+    shutil.rmtree(OUT, ignore_errors=True)
+    os.makedirs(OUT, exist_ok=True)
+    build_cmd = "env -u RUSTC -u RUSTUP_TOOLCHAIN PATH=/tmp/rustup-shims:$PATH vargo build --release"
+    subprocess.run(["bash", "-lc", build_cmd], cwd=SRC, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+    rows = []
+    mismatches = []
+    for value, resource, post in itertools.product(VALUE_CASES, RESOURCES, POSTS):
+        case_name = f"{value[0]}__{resource[0]}__{post[0]}"
+        path = os.path.join(OUT, case_name + ".rs")
+        write_case(path, resource, value[2], post[1])
+        cmd = f"./target-verus/release/verus --crate-type=lib {path}"
+        p = subprocess.run(["bash", "-lc", cmd], cwd=SRC, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        got = "ACCEPT" if accepted(p.stdout) else "REJECT"
+        expect = post[3]
+        row = (case_name, value[1], post[2], expect, got)
+        rows.append(row)
+        if got != expect:
+            mismatches.append((row, p.stdout))
+
+    with open(REPORT, "w") as f:
+        f.write("enumeration_space=value cases x resource shapes x postconditions\n")
+        f.write("value_cases=" + ", ".join(v[0] for v in VALUE_CASES) + "\n")
+        f.write("resources=" + ", ".join(r[0] for r in RESOURCES) + "\n")
+        f.write("postconditions=" + ", ".join(p[0] for p in POSTS) + "\n")
+        f.write(f"cases={len(rows)} mismatches={len(mismatches)}\n")
+        for name, ty, label, expect, got in rows:
+            f.write(f"{name}: value_ty={ty} label={label} expect={expect} got={got}\n")
+        if mismatches:
+            f.write("\nMISMATCH DETAILS\n")
+            for (name, ty, label, expect, got), out in mismatches:
+                f.write(f"\n{name}: value_ty={ty} label={label} expect={expect} got={got}\n")
+                f.write(out)
+                f.write("\n")
+    print(f"cases={len(rows)} mismatches={len(mismatches)} report={REPORT}")
+    return 1 if mismatches else 0
+
+if __name__ == "__main__":
+    raise SystemExit(main())
