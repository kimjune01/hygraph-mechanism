+#!/usr/bin/env python3
+import itertools
+import os
+import subprocess
+import textwrap
+
+ROOT = "/Users/junekim/Documents/verus-p11"
+SRC = os.path.join(ROOT, "source")
+OUT = "/tmp/p11sv-scratch/generated"
+REPORT = "/tmp/p11sv-scratch/generator_report.txt"
+
+TYPES = [
+    ("never", "!", ""),
+    ("empty_enum", "Void", "enum Void { }\n"),
+    ("tuple_empty", "(Void,)", "enum Void { }\n"),
+    ("result_empty_empty", "Result<Void, Void>", "enum Void { }\n"),
+    ("option_never", "Option<!>", ""),
+]
+
+PRODUCERS = [
+    ("direct", lambda ty: f"arbitrary::<{ty}>()"),
+    ("id", lambda ty: f"id::<{ty}>(arbitrary::<{ty}>())"),
+    ("block", lambda ty: f"{{ arbitrary::<{ty}>() }}"),
+    ("if_else", lambda ty: f"if arbitrary::<bool>() {{ arbitrary::<{ty}>() }} else {{ arbitrary::<{ty}>() }}"),
+]
+
+REACHES = [
+    ("arg", lambda expr, ty: f"sink::<{ty}>({expr});"),
+    ("let_then_arg", lambda expr, ty: f"let x: {ty} = {expr}; sink::<{ty}>(x);"),
+    ("block_arg", lambda expr, ty: f"sink::<{ty}>({{ {expr} }});"),
+]
+
+RESOURCES = [
+    ("generic", "T", "tracked t: T", "t"),
+    ("tracked_struct", "Token", "tracked t: Token", "t"),
+    ("tracked_tuple", "(Token, Token)", "tracked t: (Token, Token)", "t"),
+]
+
+POSTS = [
+    ("double_consume", "consume(t);\n    consume(t);", "UNSOUND", "REJECT"),
+    ("single_consume", "consume(t);", "VALID", "ACCEPT"),
+    ("return_double_consume", "return;\n    consume(t);\n    consume(t);", "VALID", "ACCEPT"),
+]
+
+PRELUDE = """\
+#![allow(internal_features)]
+#![feature(rustc_attrs)]
+#![feature(never_type)]
+use vstd::prelude::*;
+
+verus! {
+proof fn sink<X>(x: X) { }
+proof fn id<X>(x: X) -> X { x }
+proof fn consume<X>(tracked x: X) { }
+uninterp spec fn arbitrary<X>() -> X;
+struct Token { v: int }
+"""
+
+def write_case(path, type_def, resource, reach_stmt, post_stmt):
+    resource_ty, param, name = resource[1], resource[2], resource[3]
+    generics = "<T>" if resource_ty == "T" else ""
+    body = PRELUDE + type_def
+    body += f"""
+proof fn case_fn{generics}({param}) {{
+    {reach_stmt}
+    {post_stmt}
+}}
+}}
+fn main() {{}}
+"""
+    with open(path, "w") as f:
+        f.write(body)
+
+def accepted(output):
+    return " 0 errors" in output and "error[" not in output and "error:" not in output
+
+def main():
+    os.makedirs(OUT, exist_ok=True)
+    build_cmd = "env -u RUSTC -u RUSTUP_TOOLCHAIN PATH=/tmp/rustup-shims:$PATH vargo build --release"
+    subprocess.run(["bash", "-lc", build_cmd], cwd=SRC, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+    rows = []
+    mismatches = []
+    for (type_name, ty, type_def), (prod_name, prod), (reach_name, reach), resource, post in itertools.product(TYPES, PRODUCERS, REACHES, RESOURCES, POSTS):
+        case_name = f"{type_name}__{prod_name}__{reach_name}__{resource[0]}__{post[0]}"
+        path = os.path.join(OUT, case_name + ".rs")
+        reach_stmt = reach(prod(ty), ty)
+        write_case(path, type_def, resource, reach_stmt, post[1])
+        cmd = f"./target-verus/release/verus --crate-type=lib {path}"
+        p = subprocess.run(["bash", "-lc", cmd], cwd=SRC, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        got = "ACCEPT" if accepted(p.stdout) else "REJECT"
+        expect = post[3]
+        row = (case_name, post[2], expect, got)
+        rows.append(row)
+        if got != expect:
+            mismatches.append((row, p.stdout))
+
+    with open(REPORT, "w") as f:
+        f.write(f"cases={len(rows)} mismatches={len(mismatches)}\\n")
+        for name, label, expect, got in rows:
+            f.write(f"{name}: label={label} expect={expect} got={got}\\n")
+        if mismatches:
+            f.write("\\nMISMATCH DETAILS\\n")
+            for (name, label, expect, got), out in mismatches:
+                f.write(f"\\n{name}: label={label} expect={expect} got={got}\\n")
+                f.write(out)
+                f.write("\\n")
+    print(f"cases={len(rows)} mismatches={len(mismatches)} report={REPORT}")
+    return 1 if mismatches else 0
+
+if __name__ == "__main__":
+    raise SystemExit(main())
