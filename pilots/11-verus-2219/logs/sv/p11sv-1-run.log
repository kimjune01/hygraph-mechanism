+    ("result_never_never", "Result<!, !>", "sink_generic::<Result<!, !>>(arbitrary());"),
+    ("result_never_unit", "Result<!, ()>", "sink_generic::<Result<!, ()>>(arbitrary());"),
+    ("option_never", "Option<!>", "sink_generic::<Option<!>>(arbitrary());"),
+]
+
+RESOURCES = [
+    ("generic", "T", "tracked t: T"),
