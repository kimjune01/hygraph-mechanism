+pub fn is_erased_ghost_value_operand<'tcx>(func: &Operand<'tcx>) -> bool {
+    let Operand::Constant(func) = func else {
+        return false;
+    };
+    if !matches!(func.const_, Const::Val(ConstValue::ZeroSized, _)) {
+        return false;
+    }
+    let TyKind::FnDef(fn_def_id, _) = func.ty().kind() else {
+        return false;
+    };
+    VERUS_ERASURE_CTXT
+        .read()
+        .unwrap()
+        .as_ref()
+        .is_some_and(|ctxt| *fn_def_id == ctxt.erased_ghost_value_fn_def_id)
+}
+
 fn get_verus_erasure_ctxt_option() -> Option<Arc<VerusErasureCtxt>> {
     VERUS_ERASURE_CTXT.read().unwrap().clone()
 }
