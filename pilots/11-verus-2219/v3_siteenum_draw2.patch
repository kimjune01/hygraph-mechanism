+pub(crate) fn mir_operand_is_erased_ghost_value<'tcx>(operand: &mir::Operand<'tcx>) -> bool {
+    let Some(erasure_ctxt) = get_verus_erasure_ctxt_option() else {
+        return false;
+    };
+
+    let mir::Operand::Constant(constant) = operand else {
+        return false;
+    };
+
+    let ty = constant.const_.ty();
+    match ty.kind() {
+        TyKind::FnDef(fn_def_id, _) => *fn_def_id == erasure_ctxt.erased_ghost_value_fn_def_id,
+        _ => false,
+    }
+}
